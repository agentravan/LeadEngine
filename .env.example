# ---- Set these in Vercel > Project > Settings > Environment Variables (never commit real values) ----
SUPABASE_URL=https://zeroeprznkwhanhzwmfv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase > Project Settings > API Keys > service_role / secret key
OWNER_EMAIL=                      # the email you log in to LeadEngine with
CRON_SECRET=                      # any long random string; Vercel Cron sends it automatically

AI_API_KEY=                       # NVIDIA API key (nvapi-...)
AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

SEARCH_PROVIDER=serper            # serper | tavily | brave
SEARCH_API_KEY=

ZOHO_EMAIL=Teamwork.hrsolution@zohomail.in
ZOHO_APP_PASSWORD=                # Zoho > My Account > Security > App Passwords
# ZOHO_SMTP_HOST=smtp.zoho.in
# ZOHO_IMAP_HOST=imap.zoho.in
# NOTIFY_EMAIL=                   # where "reply received" alerts go (defaults to ZOHO_EMAIL)

DAILY_LIMIT=10                    # successful new emails per day (bounces/rejections don't count)
FOLLOWUP_LIMIT=20
MAX_AUTO_REPLIES=2                # per conversation, then it is handed to you
MIN_SCORE=5

# ---- Legacy local Docker backend ----
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://leadengine:replace-with-a-long-random-password@db:5432/leadengine
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
USER_AGENT=LeadEngine/1.0 (your contact email)
